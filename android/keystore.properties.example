# android/keystore.properties.example
#
# TEMPLATE ONLY — every value below is a placeholder. Copy this file to
# android/keystore.properties and fill it in with the real values.
#
# 🔴 keystore.properties AND the .keystore file itself are BOTH gitignored.
#    This .example file is the only one of the three that is committed.
#    Never put a real password in this file.
#
# storeFile is resolved RELATIVE TO THE android/ DIRECTORY (rootProject),
# so a keystore sitting next to this file needs only its bare filename.

storeFile=hatchgrab-upload.keystore
storePassword=REPLACE_ME
keyAlias=hatchgrab
keyPassword=REPLACE_ME
