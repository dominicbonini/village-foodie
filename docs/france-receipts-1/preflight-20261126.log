SQL [preflight]> alter table public.orders add column if not exists vat_regime text; alter table public.order_drafts add column if not exists vat_regime text; comment on column public.orders.vat_regime is 'france-receipts-1: the truck''s VAT regime (trucks.vat_regime) when the order was placed — franchise = sold under franchise en base (TVA non applicable, art. 293 B du CGI). NULL = none. Stamped by orders_stamp_vat_regime.'; comment on column public.order_drafts.vat_regime is 'france-receipts-1: the truck''s VAT regime when the card order was started; copied to the order at promotion.'; create or replace function public.orders_stamp_vat_regime() returns trigger language plpgsql security definer set search_path = public, pg_temp as $$ begin if new.vat_regime is null then begin select t.vat_regime into new.vat_regime from public.trucks t where t.id = new.truck_id; exception when others then new.vat_regime := null; raise warning 'orders_stamp_vat_regime: no regime for truck % (%: %)', new.truck_id, sqlstate, left(sqlerrm, 200); end; end if; return new; end; $$; revoke all on function public.orders_stamp_vat_regime() from public, anon, authenticated; do $$ begin if not exists (select 1 from pg_trigger where tgname = 'orders_stamp_vat_regime' and tgrelid = 'public.orders'::regclass) then create trigger orders_stamp_vat_regime before insert on public.orders for each row execute function public.orders_stamp_vat_regime(); end if; if not exists (select 1 from pg_trigger where tgname = 'order_drafts_stamp_vat_regime' and tgrelid = 'public.order_drafts'::regclass) then create trigger order_drafts_stamp_vat_regime before insert on public.order_drafts for each row execute function public.orders_stamp_vat_regime(); end if; end $$;
