SQL [till5]> select (select public from storage.buckets where id = 'till-archives') as bucket_public, (select allowed_mime_types::text from storage.buckets where id = 'till-archives') as bucket_mime, (select count(*) from pg_policies where schemaname = 'storage' and tablename = 'objects' and (coalesce(qual, '') ilike '%till-archives%' or coalesce(with_check, '') ilike '%till-archives%'))::int as bucket_policies, exists (select 1 from pg_trigger where tgname = 'till_archive_objects_keep' and tgrelid = 'storage.objects'::regclass) as objects_keep_trigger, (select bool_and(relrowsecurity) from pg_class where relnamespace = 'public'::regnamespace and relname in ('till_archives', 'till_archive_signatures')) as rls_on, (select bool_or(has_table_privilege(r, 'public.' || t, 'SELECT')) from unnest(array['anon', 'authenticated']) r, unnest(array['till_archives', 'till_archive_signatures']) t) as api_reads, (select bool_or(has_table_privilege('service_role', 'public.' || t, p)) from unnest(array['till_archives', 'till_archive_signatures']) t, unnest(array['INSERT', 'UPDATE', 'DELETE', 'TRUNCATE']) p) as service_writes, has_function_privilege('service_role', 'public.till_archive_commit(text,text,date,date,date,date,text,text,text,bigint,bigint,text,text,text,text)', 'EXECUTE') and has_function_privilege('service_role', 'public.till_sign_archive(text,uuid,text,text)', 'EXECUTE') as service_calls, (select bool_or(has_function_privilege(r, f, 'EXECUTE')) from unnest(array['anon', 'authenticated']) r, unnest(array['public.till_archive_commit(text,text,date,date,date,date,text,text,text,bigint,bigint,text,text,text,text)', 'public.till_sign_archive(text,uuid,text,text)', 'public.till_archive_object_guard()']) f) as api_calls, (select count(*) from pg_trigger where tgname in ('till_archives_append_only', 'till_archives_no_truncate', 'till_archive_signatures_append_only', 'till_archive_signatures_no_truncate'))::int as append_triggers, (select software_name || ' ' || software_version from public.till_settings where id) as software, (select guard_mode from public.till_settings where id) as guard_mode, md5(pg_get_functiondef('public.place_order_atomic_v2(jsonb,text,text,uuid,text,date,jsonb)'::regprocedure)) as v2_md5
