SQL [till2]> create temp table _till_proof (n serial primary key, label text not null, ok boolean, detail text); create temp table _till_clean (n serial primary key, label text not null, bad text); create function pg_temp.rbp_ok(p_label text, p_ok boolean, p_detail text) returns void language sql as $f$ insert into _till_proof (label, ok, detail) values (p_label, coalesce(p_ok, false), left(p_detail, 900)) $f$; create function pg_temp.rbp_food(p_items jsonb) returns integer language sql as $f$ select coalesce(sum(round((e ->> 'unit_price')::numeric * (e ->> 'quantity')::numeric * 100)), 0)::integer from jsonb_array_elements(p_items) e $f$; create function pg_temp.rbp_bd(p_food integer) returns jsonb language sql as $f$ select jsonb_build_array(jsonb_build_object('rate_milli', 10000, 'food_minor', p_food, 'gross_minor', p_food, 'net_minor', p_food - round(p_food * 10000 / 110000.0)::integer, 'tax_minor', round(p_food * 10000 / 110000.0)::integer)) $f$; create function pg_temp.rbp_walkup(p_truck text, p_day date, p_items jsonb, p_status text, p_name text, p_email text, p_phone text, p_notes text, p_line_notes jsonb) returns uuid language sql as $f$ insert into public.orders (id, truck_id, customer_name, customer_phone, customer_email, slot, order_type, event_date, event_id, items, deals, discount_code, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, card_fee_payer, status, payment_status, source, notes, line_notes) select 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, p_name, p_phone, p_email, null, 'collection', p_day, null, p_items, null, null, round(z.f / 100.0, 2), 0, round(z.f / 100.0, 2), z.f, z.f, 0, 10000, true, 'TVA', pg_temp.rbp_bd(z.f), 'truck', p_status, 'unpaid', 'manual', p_notes, p_line_notes from (select pg_temp.rbp_food(p_items) as f) z returning order_key $f$; create function pg_temp.rbp_set_items(p_key uuid, p_items jsonb) returns void language sql as $f$ update public.orders o set items = p_items, subtotal = round(z.f / 100.0, 2), total = round(z.f / 100.0, 2), total_minor = z.f, food_minor = z.f, tax_breakdown = case when o.tax_breakdown is null then null else pg_temp.rbp_bd(z.f) end from (select pg_temp.rbp_food(p_items) as f) z where o.order_key = p_key $f$; create function pg_temp.rbp_full(p_truck text, p_status text, p_source text, p_van uuid, p_currency text, p_items jsonb, p_deals jsonb, p_subtotal numeric, p_discount numeric, p_total numeric, p_total_minor integer, p_food integer, p_tax integer, p_rate integer, p_incl boolean, p_bd jsonb, p_tip integer, p_fee integer) returns uuid language sql as $f$ insert into public.orders (id, truck_id, customer_name, order_type, event_date, items, deals, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, tip_minor, service_fee_minor, service_fee_recipient, card_fee_payer, status, payment_status, source, van_id, currency) values ('rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, p_items, p_deals, p_subtotal, p_discount, p_total, p_total_minor, p_food, p_tax, p_rate, p_incl, case when p_incl then 'TVA' else 'Sales tax' end, p_bd, p_tip, p_fee, case when p_fee > 0 then 'truck' end, 'truck', p_status, 'unpaid', p_source, p_van, p_currency) returning order_key $f$; create function pg_temp.rbp_replay(p_truck text, p_key uuid) returns integer language sql as $f$ with ins as (insert into public.orders (order_key, id, truck_id, customer_name, order_type, event_date, items, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_inclusive, tax_label, card_fee_payer, status, payment_status, source) values (p_key, 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, '[]'::jsonb, 0, 0, 0, 0, 0, 0, true, 'TVA', 'truck', 'confirmed', 'unpaid', 'manual') on conflict (order_key) do nothing returning 1) select count(*)::int from ins $f$; create function pg_temp.rbp_promote(p_truck text) returns uuid language sql as $f$ insert into public.orders (order_key, id, truck_id, customer_name, customer_email, customer_phone, order_type, table_ref, slot, requested_slot, asap_estimate, event_date, event_id, van_id, items, deals, extras, bundle, discount_code, subtotal, discount_amt, total, total_minor, notes, status, payment_status, placed_at) values (gen_random_uuid(), 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', null, null, 'collection', null, null, null, null, current_date, null, null, '[{"name":"Crêpe","quantity":1,"unit_price":5}]'::jsonb, null, null, null, null, 5, 0, 5, 500, null, 'pending', 'unpaid', now()) returning order_key $f$; create function pg_temp.rbp_pay(p_key uuid, p_kind text, p_channel text, p_method text, p_amount integer, p_ref text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode) select o.order_key, o.truck_id, p_kind, p_channel, p_amount, o.currency, 'succeeded', p_ref, 'rollback proof — staff note', 'rbp:' || gen_random_uuid(), 'rbp-staff-user', p_method, false from public.orders o where o.order_key = p_key returning id $f$; create function pg_temp.rbp_entries(p_truck text, p_kind text, p_ref text) returns integer language sql as $f$ select count(*)::int from public.till_chain c where c.truck_id = p_truck and c.kind = p_kind and c.ref = p_ref $f$; create function pg_temp.rbp_reasons(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(c.version || ':' || (c.payload::jsonb ->> 'reason') || ':' || coalesce(c.payload::jsonb -> 'data' ->> 'fiscal_state', ''), ',' order by c.seq), '') from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref $f$; create function pg_temp.rbp_events(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(g.event, ',' order by g.id), '') from public.till_guard_events g where g.truck_id = p_truck and g.ref = p_ref $f$; create function pg_temp.rbp_data(p_truck text, p_ref text) returns jsonb language sql as $f$ select c.payload::jsonb from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref order by c.seq desc limit 1 $f$; create function pg_temp.rbp_snap(p_trucks text[]) returns text language sql as $f$ select coalesce(string_agg(x, ';' order by x), '') from ( select 'o:' || o.order_key || '@' || o.ctid::text || '/' || o.xmin::text || '/' || coalesce(o.updated_at::text, '') as x from public.orders o where o.truck_id = any (p_trucks) union all select 'p:' || p.id || '@' || p.ctid::text || '/' || p.xmin::text from public.order_payments p where p.truck_id = any (p_trucks)) z $f$; create function pg_temp.rbp_clean(p_label text, p_trucks text[]) returns void language sql as $f$ insert into _till_clean (label, bad) select p_label, string_agg(z.k, ',') from ( select 'order ' || o.order_key as k from public.orders o where o.truck_id = any (p_trucks) and o.xmin::text <> (pg_current_xact_id()::xid)::text union all select 'payment ' || p.id from public.order_payments p where p.truck_id = any (p_trucks) and p.xmin::text <> (pg_current_xact_id()::xid)::text) z $f$; create function pg_temp.rbp_reverse(p_pay uuid, p_reason text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode, reverses_payment_id, reason) select p.order_key, p.truck_id, 'reversal', p.channel, p.amount_minor, p.currency, 'succeeded', null, 'rollback proof reversal', 'reversal:' || p.id, 'rbp-staff-user', p.method, p.livemode, p.id, p_reason from public.order_payments p where p.id = p_pay returning id $f$; create function pg_temp.rbp_refund(p_key uuid, p_channel text, p_method text, p_amount integer, p_reason text, p_ikey text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode, reason) select o.order_key, o.truck_id, 'refund', p_channel, p_amount, o.currency, 'succeeded', null, 'rollback proof refund', p_ikey, 'rbp-staff-user', p_method, true, p_reason from public.orders o where o.order_key = p_key returning id $f$; -- getOrderBalance in SQL: the netted, live, succeeded rows; paid = charges − refunds; 'refunded' when paid 0 with a refund row. create function pg_temp.rbp_status(p_key uuid) returns text language sql as $f$ with r as (select * from public.order_payments p where p.order_key = p_key and p.state = 'succeeded' and p.livemode and p.kind <> 'reversal' and not exists (select 1 from public.order_payments v where v.kind = 'reversal' and v.reverses_payment_id = p.id)), s as (select coalesce(sum(case when kind = 'charge' then amount_minor else 0 end), 0) - coalesce(sum(case when kind = 'refund' then amount_minor else 0 end), 0) as paid, bool_or(kind = 'refund') as has_refund from r) select case when s.paid = 0 and coalesce(s.has_refund, false) then 'refunded' when s.paid = 0 then 'unpaid' else 'paid:' || s.paid end from s $f$; -- a LIVE payment (rbp_pay writes test-mode rows, which getOrderBalance — and rbp_status — rightly do not count) create function pg_temp.rbp_pay_live(p_key uuid, p_kind text, p_channel text, p_method text, p_amount integer, p_ref text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode) select o.order_key, o.truck_id, p_kind, p_channel, p_amount, o.currency, 'succeeded', p_ref, 'rollback proof — staff note', 'rbp:' || gen_random_uuid(), 'rbp-staff-user', p_method, true from public.orders o where o.order_key = p_key returning id $f$; create function pg_temp.rbp_walkup_keyed(p_key uuid, p_truck text, p_items jsonb) returns uuid language sql as $f$ insert into public.orders (order_key, id, truck_id, customer_name, order_type, event_date, items, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, card_fee_payer, status, payment_status, source) select p_key, 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, p_items, round(z.f / 100.0, 2), 0, round(z.f / 100.0, 2), z.f, z.f, 0, 10000, true, 'TVA', pg_temp.rbp_bd(z.f), 'truck', 'confirmed', 'unpaid', 'manual' from (select pg_temp.rbp_food(p_items) as f) z returning order_key $f$;
SQL [till2]> do $proof$ declare k1 uuid; k2 uuid; k3 uuid; k4 uuid; k5 uuid; k6 uuid; k7 uuid; k8 uuid; k9 uuid; kd uuid; kd2 uuid; p1 uuid; p2 uuid; p3 uuid; p4 uuid; p5 uuid; p6 uuid; p7 uuid; p8 uuid; r1 uuid; r2 uuid; r3 uuid; r4 uuid; q1 uuid; q2 uuid; st text; st2 text; st3 text; st4 text; st5 text; st6 text; st7 text; v jsonb; x jsonb; y jsonb; n integer; n2 integer; hs bigint; b boolean; b2 boolean; b3 boolean; begin perform set_config('till.include_demo', 'on', true); -- ── T1 · the constraints: a reversal must point, only a reversal points, one reversal per payment, the reason is a word ── k1 := pg_temp.rbp_walkup('demo-mk65q66spjck0g9mxt50btfxtr', current_date, '[{"name":"Crêpe","quantity":1,"unit_price":5}]', 'confirmed', 'rollback proof', null, null, null, null); p1 := pg_temp.rbp_pay_live(k1, 'charge', 'in_person_other', 'cash', 500, null); begin insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, livemode) select order_key, truck_id, 'reversal', 'in_person_other', 500, currency, 'succeeded', true from public.order_payments where id = p1; st := 'allowed'; exception when others then st := sqlstate; end; begin insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, livemode, reverses_payment_id) select order_key, truck_id, 'charge', 'in_person_other', 500, currency, 'succeeded', true, p1 from public.order_payments where id = p1; st2 := 'allowed'; exception when others then st2 := sqlstate; end; begin perform pg_temp.rbp_refund(k1, 'in_person_other', 'cash', 100, 'Free text, with spaces', null); st3 := 'allowed'; exception when others then st3 := sqlstate; end; begin insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, livemode) select order_key, truck_id, 'void', 'in_person_other', 500, currency, 'succeeded', true from public.order_payments where id = p1; st4 := 'allowed'; exception when others then st4 := sqlstate; end; r1 := pg_temp.rbp_reverse(p1, 'undo_mark_paid'); begin insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, livemode, reverses_payment_id) select order_key, truck_id, 'reversal', channel, amount_minor, currency, 'succeeded', true, id from public.order_payments where id = p1; st5 := 'allowed'; exception when others then st5 := sqlstate; end; perform pg_temp.rbp_ok('T1 · a reversal without a pointer, a charge WITH one, a free-text reason and an unknown kind are refused (23514); a second reversal of the same payment is refused (23505); a proper reversal goes in', st = '23514' and st2 = '23514' and st3 = '23514' and st4 = '23514' and st5 = '23505' and r1 is not null, json_build_object('no_pointer', st, 'charge_pointer', st2, 'free_reason', st3, 'unknown_kind', st4, 'second_reversal', st5)::text); -- ── T2 · undo "Mark paid" (as the new code does it): one reversal row, NO delete — the charge stays; status 'unpaid' exactly as after the old delete ── perform pg_temp.rbp_ok('T2 · undo Mark paid: the charge row is KEPT, one reversal row points at it, nothing is deleted or logged as a would-be delete; the netted status is ''unpaid''; the chain holds both payment entries, the reversal with its pointer and reason', exists (select 1 from public.order_payments where id = p1) and (select count(*) from public.order_payments where reverses_payment_id = p1) = 1 and pg_temp.rbp_status(k1) = 'unpaid' and pg_temp.rbp_entries('demo-mk65q66spjck0g9mxt50btfxtr', 'deletion', p1::text) = 0 and pg_temp.rbp_events('demo-mk65q66spjck0g9mxt50btfxtr', p1::text) = '' and pg_temp.rbp_entries('demo-mk65q66spjck0g9mxt50btfxtr', 'payment', p1::text) = 1 and pg_temp.rbp_entries('demo-mk65q66spjck0g9mxt50btfxtr', 'payment', r1::text) = 1 and (select c.payload::jsonb -> 'data' ->> 'reverses_payment_id' from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'payment' and c.ref = r1::text) = p1::text and (select c.payload::jsonb -> 'data' ->> 'reason' from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'payment' and c.ref = r1::text) = 'undo_mark_paid' and (select c.payload::jsonb -> 'data' ->> 'kind' from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'payment' and c.ref = r1::text) = 'reversal', json_build_object('status', pg_temp.rbp_status(k1), 'reversals', (select count(*) from public.order_payments where reverses_payment_id = p1))::text); perform pg_temp.rbp_clean('T2', array['demo-mk65q66spjck0g9mxt50btfxtr', 'test-truck-2']); -- ── T3 · undo collected: the payment first, then the status (as the route), then the undo — the reversal and the status back ── k2 := pg_temp.rbp_walkup('demo-mk65q66spjck0g9mxt50btfxtr', current_date, '[{"name":"Crêpe","quantity":1,"unit_price":5}]', 'confirmed', 'rollback proof', null, null, null, null); p2 := pg_temp.rbp_pay_live(k2, 'charge', 'in_person_other', 'card', 500, null); update public.orders set status = 'collected', paid_at = now(), collected_at = now(), status_before_collected = 'confirmed' where order_key = k2; hs := public.till_head_seq('demo-mk65q66spjck0g9mxt50btfxtr'); r2 := pg_temp.rbp_reverse(p2, 'undo_collected'); update public.orders set status = 'confirmed', status_before_collected = null, paid_at = null, collected_at = null where order_key = k2; n := public.till_record_actor('demo-mk65q66spjck0g9mxt50btfxtr', hs, k2, 'undo_collected', 'staff'); n2 := public.till_record_actor('demo-mk65q66spjck0g9mxt50btfxtr', hs, k2, 'undo_collected', 'owner'); perform pg_temp.rbp_ok('T3 · undo collected: one reversal (reason undo_collected), the charge kept, status ''unpaid'', the order back to accepted as v3 (state_change) — and no deletion entry', pg_temp.rbp_status(k2) = 'unpaid' and exists (select 1 from public.order_payments where id = p2) and pg_temp.rbp_entries('demo-mk65q66spjck0g9mxt50btfxtr', 'deletion', p2::text) = 0 and pg_temp.rbp_reasons('de