mn_default, 'none'), ',' order by column_name) from information_schema.columns where table_schema = 'public' and table_name = 'till_settings' and column_name in ('signing_public_key', 'signing_key_id')) as settings_cols, (select guard_mode from public.till_settings where id) as guard_mode, md5(pg_get_functiondef('public.place_order_atomic_v2(jsonb,text,text,uuid,text,date,jsonb)'::regprocedure)) as v2_md5
