SQL [preflight4]> create temp table _till_proof (n serial primary key, label text not null, ok boolean, detail text); create temp table _till_clean (n serial primary key, label text not null, bad text); create function pg_temp.rbp_ok(p_label text, p_ok boolean, p_detail text) returns void language sql as $f$ insert into _till_proof (label, ok, detail) values (p_label, coalesce(p_ok, false), left(p_detail, 900)) $f$; create function pg_temp.rbp_food(p_items jsonb) returns integer language sql as $f$ select coalesce(sum(round((e ->> 'unit_price')::numeric * (e ->> 'quantity')::numeric * 100)), 0)::integer from jsonb_array_elements(p_items) e $f$; create function pg_temp.rbp_bd(p_food integer) returns jsonb language sql as $f$ select jsonb_build_array(jsonb_build_object('rate_milli', 10000, 'food_minor', p_food, 'gross_minor', p_food, 'net_minor', p_food - round(p_food * 10000 / 110000.0)::integer, 'tax_minor', round(p_food * 10000 / 110000.0)::integer)) $f$; create function pg_temp.rbp_walkup(p_truck text, p_day date, p_items jsonb, p_status text, p_name text, p_email text, p_phone text, p_notes text, p_line_notes jsonb) returns uuid language sql as $f$ insert into public.orders (id, truck_id, customer_name, customer_phone, customer_email, slot, order_type, event_date, event_id, items, deals, discount_code, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, card_fee_payer, status, payment_status, source, notes, line_notes) select 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, p_name, p_phone, p_email, null, 'collection', p_day, null, p_items, null, null, round(z.f / 100.0, 2), 0, round(z.f / 100.0, 2), z.f, z.f, 0, 10000, true, 'TVA', pg_temp.rbp_bd(z.f), 'truck', p_status, 'unpaid', 'manual', p_notes, p_line_notes from (select pg_temp.rbp_food(p_items) as f) z returning order_key $f$; create function pg_temp.rbp_set_items(p_key uuid, p_items jsonb) returns void language sql as $f$ update public.orders o set items = p_items, subtotal = round(z.f / 100.0, 2), total = round(z.f / 100.0, 2), total_minor = z.f, food_minor = z.f, tax_breakdown = case when o.tax_breakdown is null then null else pg_temp.rbp_bd(z.f) end from (select pg_temp.rbp_food(p_items) as f) z where o.order_key = p_key $f$; create function pg_temp.rbp_full(p_truck text, p_status text, p_source text, p_van uuid, p_currency text, p_items jsonb, p_deals jsonb, p_subtotal numeric, p_discount numeric, p_total numeric, p_total_minor integer, p_food integer, p_tax integer, p_rate integer, p_incl boolean, p_bd jsonb, p_tip integer, p_fee integer) returns uuid language sql as $f$ insert into public.orders (id, truck_id, customer_name, order_type, event_date, items, deals, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, tip_minor, service_fee_minor, service_fee_recipient, card_fee_payer, status, payment_status, source, van_id, currency) values ('rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, p_items, p_deals, p_subtotal, p_discount, p_total, p_total_minor, p_food, p_tax, p_rate, p_incl, case when p_incl then 'TVA' else 'Sales tax' end, p_bd, p_tip, p_fee, case when p_fee > 0 then 'truck' end, 'truck', p_status, 'unpaid', p_source, p_van, p_currency) returning order_key $f$; create function pg_temp.rbp_replay(p_truck text, p_key uuid) returns integer language sql as $f$ with ins as (insert into public.orders (order_key, id, truck_id, customer_name, order_type, event_date, items, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_inclusive, tax_label, card_fee_payer, status, payment_status, source) values (p_key, 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, '[]'::jsonb, 0, 0, 0, 0, 0, 0, true, 'TVA', 'truck', 'confirmed', 'unpaid', 'manual') on conflict (order_key) do nothing returning 1) select count(*)::int from ins $f$; create function pg_temp.rbp_promote(p_truck text) returns uuid language sql as $f$ insert into public.orders (order_key, id, truck_id, customer_name, customer_email, customer_phone, order_type, table_ref, slot, requested_slot, asap_estimate, event_date, event_id, van_id, items, deals, extras, bundle, discount_code, subtotal, discount_amt, total, total_minor, notes, status, payment_status, placed_at) values (gen_random_uuid(), 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', null, null, 'collection', null, null, null, null, current_date, null, null, '[{"name":"Crêpe","quantity":1,"unit_price":5}]'::jsonb, null, null, null, null, 5, 0, 5, 500, null, 'pending', 'unpaid', now()) returning order_key $f$; create function pg_temp.rbp_pay(p_key uuid, p_kind text, p_channel text, p_method text, p_amount integer, p_ref text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode) select o.order_key, o.truck_id, p_kind, p_channel, p_amount, o.currency, 'succeeded', p_ref, 'rollback proof — staff note', 'rbp:' || gen_random_uuid(), 'rbp-staff-user', p_method, false from public.orders o where o.order_key = p_key returning id $f$; create function pg_temp.rbp_entries(p_truck text, p_kind text, p_ref text) returns integer language sql as $f$ select count(*)::int from public.till_chain c where c.truck_id = p_truck and c.kind = p_kind and c.ref = p_ref $f$; create function pg_temp.rbp_reasons(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(c.version || ':' || (c.payload::jsonb ->> 'reason') || ':' || coalesce(c.payload::jsonb -> 'data' ->> 'fiscal_state', ''), ',' order by c.seq), '') from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref $f$; create function pg_temp.rbp_events(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(g.event, ',' order by g.id), '') from public.till_guard_events g where g.truck_id = p_truck and g.ref = p_ref $f$; create function pg_temp.rbp_data(p_truck text, p_ref text) returns jsonb language sql as $f$ select c.payload::jsonb from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref order by c.seq desc limit 1 $f$; create function pg_temp.rbp_snap(p_trucks text[]) returns text language sql as $f$ select coalesce(string_agg(x, ';' order by x), '') from ( select 'o:' || o.order_key || '@' || o.ctid::text || '/' || o.xmin::text || '/' || coalesce(o.updated_at::text, '') as x from public.orders o where o.truck_id = any (p_trucks) union all select 'p:' || p.id || '@' || p.ctid::text || '/' || p.xmin::text from public.order_payments p where p.truck_id = any (p_trucks)) z $f$; create function pg_temp.rbp_clean(p_label text, p_trucks text[]) returns void language sql as $f$ insert into _till_clean (label, bad) select p_label, string_agg(z.k, ',') from ( select 'order ' || o.order_key as k from public.orders o where o.truck_id = any (p_trucks) and o.xmin::text <> (pg_current_xact_id()::xid)::text union all select 'payment ' || p.id from public.order_payments p where p.truck_id = any (p_trucks) and p.xmin::text <> (pg_current_xact_id()::xid)::text) z $f$; create function pg_temp.rbp_reverse(p_pay uuid, p_reason text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode, reverses_payment_id, reason) select p.order_key, p.truck_id, 'reversal', p.channel, p.amount_minor, p.currency, 'succeeded', null, 'rollback proof reversal', 'reversal:' || p.id, 'rbp-staff-user', p.method, p.livemode, p.id, p_reason from public.order_payments p where p.id = p_pay returning id $f$; create function pg_temp.rbp_refund(p_key uuid, p_channel text, p_method text, p_amount integer, p_reason text, p_ikey text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode, reason) select o.order_key, o.truck_id, 'refund', p_channel, p_amount, o.currency, 'succeeded', null, 'rollback proof refund', p_ikey, 'rbp-staff-user', p_method, true, p_reason from public.orders o where o.order_key = p_key returning id $f$; -- getOrderBalance in SQL: the netted, live, succeeded rows; paid = charges − refunds; 'refunded' when paid 0 with a refund row. create function pg_temp.rbp_status(p_key uuid) returns text language sql as $f$ with r as (select * from public.order_payments p where p.order_key = p_key and p.state = 'succeeded' and p.livemode and p.kind <> 'reversal' and not exists (select 1 from public.order_payments v where v.kind = 'reversal' and v.reverses_payment_id = p.id)), s as (select coalesce(sum(case when kind = 'charge' then amount_minor else 0 end), 0) - coalesce(sum(case when kind = 'refund' then amount_minor else 0 end), 0) as paid, bool_or(kind = 'refund') as has_refund from r) select case when s.paid = 0 and coalesce(s.has_refund, false) then 'refunded' when s.paid = 0 then 'unpaid' else 'paid:' || s.paid end from s $f$; -- a LIVE payment (rbp_pay writes test-mode rows, which getOrderBalance — and rbp_status — rightly do not count) create function pg_temp.rbp_pay_live(p_key uuid, p_kind text, p_channel text, p_method text, p_amount integer, p_ref text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode) select o.order_key, o.truck_id, p_kind, p_channel, p_amount, o.currency, 'succeeded', p_ref, 'rollback proof — staff note', 'rbp:' || gen_random_uuid(), 'rbp-staff-user', p_method, true from public.orders o where o.order_key = p_key returning id $f$; create function pg_temp.rbp_walkup_keyed(p_key uuid, p_truck text, p_items jsonb) returns uuid language sql as $f$ insert into public.orders (order_key, id, truck_id, customer_name, order_type, event_date, items, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, card_fee_payer, status, payment_status, source) select p_key, 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, p_items, round(z.f / 100.0, 2), 0, round(z.f / 100.0, 2), z.f, z.f, 0, 10000, true, 'TVA', pg_temp.rbp_bd(z.f), 'truck', 'confirmed', 'unpaid', 'manual' from (select pg_temp.rbp_food(p_items) as f) z returning order_key $f$; create function pg_temp.rbp4_order(p_truck text, p_day date, p_at timestamptz, p_status text, p_source text, p_van uuid, p_event uuid, p_items jsonb, p_bd jsonb, p_minor integer, p_rate integer) returns uuid language sql as $f$ insert into public.orders (id, truck_id, customer_name, order_type, event_date, event_id, van_id, items, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, card_fee_payer, status, payment_status, source, created_at, placed_at, currency) values ('rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', p_day, p_event, p_van, p_items, round(p_minor / 100.0, 2), 0, round(p_minor / 100.0, 2), p_minor, p_minor, 0, p_rate, true, 'TVA', p_bd, 'truck', p_status, 'unpaid', p_source, p_at, p_at, 'EUR') returning order_key $f$; create function pg_temp.rbp4_pay(p_key uuid, p_kind text, p_channel text, p_method text, p_amount integer, p_at timestamptz) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode, created_at) select o.order_key, o.truck_id, p_kind, p_channel, p_amount, o.currency, 'succeeded', null, 'rollback proof', 'rbp4:' || gen_random_uuid(), 'rbp-staff-user', p_method, true, p_at from public.orders o where o.order_key = p_key returning id $f$; create function pg_temp.rbp4_reverse(p_pay uuid, p_at timestamptz) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode, reverses_payment_id, reason, created_at) select p.order_key, p.truck_id, 'reversal', p.channel, p.amount_minor, p.currency, 'succeeded', null, 'rollback proof reversal', 'reversal:' || p.id, 'rbp-staff-user', p.method, p.livemode, p.id, 'undo_mark_paid', p_at from public.order_payments p where p.id = p_pay returning id $f$;
