lose(text, bigint, text, text) to service_role; grant execute on function public.till_correction_check(uuid) to service_role; grant execute on function public.till_verify(text) to service_role; do $$ begin if not exists (select 1 from pg_trigger where tgname = 'till_closes_append_only' and tgrelid = 'public.till_closes'::regclass) then create trigger till_closes_append_only before update or delete on public.till_closes for each row execute function public.till_refuse_change(); end if; if not exists (select 1 from pg_trigger where tgname = 'till_closes_no_truncate' and tgrelid = 'public.till_closes'::regclass) then create trigger till_closes_no_truncate before truncate on public.till_closes for each statement execute function public.till_refuse_change(); end if; if not exists (select 1 from pg_trigger where tgname = 'till_close_signatures_append_only' and tgrelid = 'public.till_close_signatures'::regclass) then create trigger till_close_signatures_append_only before update or delete on public.till_close_signatures for each row execute function public.till_refuse_change(); end if; if not exists (select 1 from pg_trigger where tgname = 'till_close_signatures_no_truncate' and tgrelid = 'public.till_close_signatures'::regclass) then create trigger till_close_signatures_no_truncate before truncate on public.till_close_signatures for each statement execute function public.till_refuse_change(); end if; end $$;
