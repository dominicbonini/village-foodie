or v_hseq = 0)) or (v_hseq = v_next - 1 and v_hhash = v_prev and v_hidseq is not distinct from v_id_seq and v_hidhash is not distinct from v_id_hash); for s in select * from public.till_order_seals x where x.truck_id = p_truck loop select c.* into r from public.till_chain c where c.truck_id = p_truck and c.seq = s.last_seq; if r.seq is null or r.kind <> 'order' or r.ref <> s.order_key::text or r.version is distinct from s.version or r.payload_hash <> s.last_payload_hash or exists (select 1 from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = s.order_key::text and c.seq > s.last_seq) then v_mis := v_mis || jsonb_build_object('ref', s.order_key, 'kind', 'order', 'problem', 'seal state differs from the chain'); elsif s.deleted_at is null then select o.* into ro from public.orders o where o.order_key = s.order_key; if ro.order_key is null then v_mis := v_mis || jsonb_build_object('ref', s.order_key, 'kind', 'order', 'problem', 'row gone, no deletion entry'); elsif ((r.payload::jsonb) -> 'data')::text is distinct from public.till_sealed_order(public.till_row_as_sealed(ro, (r.payload::jsonb) -> 'data'))::text then v_mis := v_mis || jsonb_build_object('ref', s.order_key, 'kind', 'order', 'problem', 'row differs from its sealed form'); end if; elsif not exists (select 1 from public.till_chain d where d.truck_id = p_truck and d.kind = 'deletion' and d.ref = s.order_key::text and d.seq > s.last_seq) then v_mis := v_mis || jsonb_build_object('ref', s.order_key, 'kind', 'order', 'problem', 'marked deleted, no deletion entry'); end if; end loop; for r in select distinct c.ref from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and not exists (select 1 from public.till_order_seals x where x.order_key::text = c.ref) loop v_mis := v_mis || jsonb_build_object('ref', r.ref, 'kind', 'order', 'problem', 'entries but no seal state'); end loop; for r in select distinct c.ref from public.till_chain c where c.truck_id = p_truck and c.kind = 'payment' loop select c.payload, c.seq into v_lpay, v_lseq from public.till_chain c where c.truck_id = p_truck and c.kind = 'payment' and c.ref = r.ref order by c.seq desc limit 1; if exists (select 1 from public.order_payments p where p.id::text = r.ref) then if ((v_lpay::jsonb) -> 'data')::text is distinct from (select public.till_sealed_payment(p)::text from public.order_payments p where p.id::text = r.ref) then v_mis := v_mis || jsonb_build_object('ref', r.ref, 'kind', 'payment', 'problem', 'row differs from its sealed form'); end if; elsif not exists (select 1 from public.till_chain d where d.truck_id = p_truck and d.kind = 'deletion' and d.ref = r.ref and d.seq > v_lseq) then v_mis := v_mis || jsonb_build_object('ref', r.ref, 'kind', 'payment', 'problem', 'row gone, no deletion entry'); end if; end loop; select count(*) into v_unsealed from public.orders o where o.truck_id = p_truck and public.till_fiscal_state(o.status) <> 'pending' and not exists (select 1 from public.till_order_seals x where x.order_key = o.order_key); select count(*) into v_unchained from public.order_payments p where p.truck_id = p_truck and not exists (select 1 from public.till_chain c where c.truck_id = p_truck and c.kind = 'payment' and c.ref = p.id::text); for s in select x.period_type, x.period_start, x.seq, x.hash from public.till_closes x where x.truck_id = p_truck loop if not exists (select 1 from public.till_chain c where c.truck_id = p_truck and c.seq = s.seq and c.kind = 'close' and c.hash = s.hash) then v_mis := v_mis || jsonb_build_object('ref', s.period_type || ':' || s.period_start, 'kind', 'close', 'problem', 'close row does not match its chain entry'); end if; end loop; return jsonb_build_object( 'truck_id', p_truck, 'ok', v_gaps = 0 and v_links = 0 and v_phash = 0 and v_hash = 0 and coalesce(v_head_ok, false) and v_struct = 0 and v_idref = 0 and v_vers = 0 and v_deltas = 0 and v_tillid = 0 and v_recon = 0 and jsonb_array_length(v_mis) = 0, 'entries', v_n, 'gaps', v_g