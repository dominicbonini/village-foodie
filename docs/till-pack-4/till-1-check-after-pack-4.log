20 %; a deal split 10 % / 20 % by the VAT engine; a 10 % discount): basis breakdown; Galette 1227, Cidre 300, Pain 282, the deal''s parts 696 + 337 excl. VAT; per rate 282 / 1923 / 637 + VAT 15 / 192 / 128 = the food 3177', pg_temp.rbp_vatsig(x) = '{"b": "breakdown", "i": [[10000, 1500, 1227], [20000, 400, 300], [5500, 330, 282]], "d": [[[10000, 850, 696], [20000, 450, 337]]], "s": [[5500, 297, 282, 15], [10000, 2115, 1923, 192], [20000, 765, 637, 128]]}'::jsonb and public.till_vat_reconciles(x), pg_temp.rbp_vatsig(x)::text); k_us := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', 'web', null, 'USD', '[{"name":"Burger","quantity":2,"unit_price":8.00,"tax_rate_milli":6625}]', null, 16.00, 0, 20.06, 2006, 1600, 106, 6625, false, '[{"rate_milli":6625,"food_minor":1600,"gross_minor":1706,"net_minor":1600,"tax_minor":106}]', 200, 100); k_leg := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', 'manual', null, 'GBP', '[{"name":"Fish","quantity":1,"unit_price":9.00}]', '[{"name":"Combo","price":6.50,"slots":{"main":"Fish"},"slotModifiers":{"main":[{"name":"Peas","price":0.50}]}}]', 16.00, 0, 16.00, 1600, null, 0, null, null, null, 0, 0); k_or := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', 'web', null, 'GBP', '[{"name":"Pie","quantity":1,"unit_price":12.00}]', null, 12.00, 0, 12.00, 1200, 1200, 0, 20000, true, null, 0, 0); k_jp := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', 'web', null, 'JPY', '[{"name":"Ramen","quantity":1,"unit_price":1500}]', null, 1500, 0, 1500, 1500, 1500, 0, 10000, true, null, 0, 0); k_rc := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', 'web', null, 'EUR', '[{"name":"Crêpe","quantity":1,"unit_price":5,"tax_rate_milli":10000}]', null, 5, 0, 5, 500, 500, 0, 10000, true, '[{"rate_milli":5500,"food_minor":500,"gross_minor":500,"net_minor":474,"tax_minor":26}]', 0, 0); perform pg_temp.rbp_ok('14b · VAT added (US, 6.625 %, a tip and a service fee): excl = food 1600, VAT 106 = tax_minor, total 2006; a pre-charge-columns order (legacy, no rate) with an old deal (no split): Fish 900 + Combo 700 = (subtotal − discount); one older rate on the order (20 % included): 1000 + 200; JPY (no decimals): 1364 + 136; a breakdown that does not match the lines: recomputed, 455 + 45 — every one reconciling', pg_temp.rbp_vatsig(pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_us::text) -> 'data') = '{"b": "breakdown", "i": [[6625, 1600, 1600]], "d": [], "s": [[6625, 1600, 1600, 106]]}'::jsonb and pg_temp.rbp_vatsig(pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_leg::text) -> 'data') = '{"b": "legacy", "i": [[null, 900, 900]], "d": [[[null, 700, 700]]], "s": [[null, 1600, 1600, 0]]}'::jsonb and pg_temp.rbp_vatsig(pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_or::text) -> 'data') = '{"b": "order_rate", "i": [[20000, 1200, 1000]], "d": [], "s": [[20000, 1200, 1000, 200]]}'::jsonb and pg_temp.rbp_vatsig(pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_jp::text) -> 'data') = '{"b": "order_rate", "i": [[10000, 1500, 1364]], "d": [], "s": [[10000, 1500, 1364, 136]]}'::jsonb and pg_temp.rbp_vatsig(pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_rc::text) -> 'data') = '{"b": "recomputed", "i": [[10000, 500, 455]], "d": [], "s": [[10000, 500, 455, 45]]}'::jsonb and (select bool_and(public.till_vat_reconciles(pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k::text) -> 'data')) from unnest(array[k_us, k_leg, k_or, k_jp, k_rc]) k), (select string_agg(pg_temp.rbp_vatsig(pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k::text) -> 'data')::text, ' | ') from unnest(array[k_us, k_leg, k_or, k_jp, k_rc]) k)); perform pg_temp.rbp_ok('14c · the check is real: one line''s excl. VAT +1, or the order''s total +1, no longer reconciles', not public.till_vat_reconciles(jsonb_set(x, '{items,0,line_total_excl_vat_minor}', '1228'::jsonb)) and not public.till_vat_reconciles(jsonb_set(x, '{total_minor}', '3178'::jsonb)) and not public.till_vat_reconciles(jsonb_set(x, '{deals,0,vat_parts,1,vat_rate_milli}', '5500'::jsonb)), null); perform pg_temp.rbp_clean('14', array['demo-mk65q66spjck0g9mxt50btfxtr', 'test-truck-2']); -- ── 15 · change 3: a till number on every version — the van, else 'web' for an online order, else the recorded source ── v_van := (select v.id from public.truck_vans v where v.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' order by v.created_at nulls last, v.id limit 1); k_van := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', 'web', v_van, 'EUR', '[{"name":"Crêpe","quantity":1,"unit_price":5}]', null, 5, 0, 5, 500, 500, 0, 10000, true, null, 0, 0); k_web := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', 'web', null, 'EUR', '[{"name":"Crêpe","quantity":1,"unit_price":5}]', null, 5, 0, 5, 500, 500, 0, 10000, true, null, 0, 0); k_src := pg_temp.rbp_full('demo-mk65q66spjck0g9mxt50btfxtr', 'confirmed', null, null, 'EUR', '[{"name":"Crêpe","quantity":1,"unit_price":5}]', null, 5, 0, 5, 500, 500, 0, 10000, true, null, 0, 0); perform pg_temp.rbp_ok('15 · till_id: the van''s id for an order with a van; ''web'' for an online order without one; ''manual'' for a walk-up; ''unrecorded'' when even the source is empty — and no order version anywhere without one', v_van is not null and pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_van::text) -> 'data' ->> 'till_id' = v_van::text and pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_web::text) -> 'data' ->> 'till_id' = 'web' and pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_walk::text) -> 'data' ->> 'till_id' = 'manual' and pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_src::text) -> 'data' ->> 'till_id' = 'unrecorded' and not exists (select 1 from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'order' and coalesce(c.payload::jsonb -> 'data' ->> 'till_id', '') = ''), json_build_object('van', v_van, 'got', array[pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_van::text) -> 'data' ->> 'till_id', pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_web::text) -> 'data' ->> 'till_id', pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_walk::text) -> 'data' ->> 'till_id', pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_src::text) -> 'data' ->> 'till_id'])::text); perform pg_temp.rbp_clean('15', array['demo-mk65q66spjck0g9mxt50btfxtr', 'test-truck-2']); -- ── 16 · change 4: identity entries — at the first sealed entry, and AT ONCE when the receipt details change; versions name the one in force ── n_id := (select count(*) from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and kind = 'identity'); s1 := pg_temp.rbp_snap(array['demo-mk65q66spjck0g9mxt50btfxtr', 'test-truck-2']); update public.trucks set legal_name = 'Rollback Proof SARL', registered_address = '{"address":"1 rue du Test","town":"Paris","postcode":"75001","floor":"2"}'::jsonb, registration_number = '73282932000074', vat_number = 'FR44732829320', vat_regime = 'reel_simplifie' where id = 'demo-mk65q66spjck0g9mxt50btfxtr'; s2 := pg_temp.rbp_snap(array['demo-mk65q66spjck0g9mxt50btfxtr', 'test-truck-2']); y := (select c.payload::jsonb from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'identity' order by c.seq desc limit 1); update public.trucks set legal_name = legal_name, timezone = timezone where id = 'demo-mk65q66spjck0g9mxt50btfxtr'; -- nothing really changed c1 := (select count(*) from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and kind = 'identity'); perform pg_temp.rbp_set_items(k_walk, '[{"name":"Crêpe","quantity":3,"unit_price":5}]'); x := pg_temp.rbp_data('demo-mk65q66spjck0g9mxt50btfxtr', k_walk::text); perform pg_temp.rbp_ok('16 · the identity: one entry before the first order; a change of the receipt details writes identity v2 at once (whitelisted: legal name, address — its unknown key named only — SIRET, VAT number, regime); a non-change writes nothing; the next order version names identity v2 {seq, hash}; no order or payment row touched', n_id = 1 and c1 = 2 and s1 = s2 and (y ->> 'version')::int = 2 and y ->> 'reason' = 'changed' and y -> 'data' = '{"legal_name": "Rollback Proof SARL", "registered_address": {"address": "1 rue du Test", "town": "Paris", "postcode": "75001", "_other_keys": ["floor"]}, "registration_number": "73282932000074", "vat_number": "FR44732829320", "vat_regime": "reel_simplifie"}'::jsonb and x -> 'identity' = (select jsonb_build_object('seq', c.seq, 'hash', c.hash) from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'identity' and c.version = 2) and pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_walk::text) like '%,4:edit:accepted', json_build_object('before', n_id, 'after', c1, 'identity', y -> 'data', 'ref', x -> 'identity')::text); perform pg_temp.rbp_clean('16', array['demo-mk65q66spjck0g9mxt50btfxtr', 'test-truck-2']); -- ── 17 · change 5: every version after the first carries its delta, the first none (and till_verify recomputes each one) ── perform pg_temp.rbp_ok('17b · every order version 2+ carries a plus/minus delta, every version 1 none', (select count(*) from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'order' and ((c.version = 1) = ((c.payload::jsonb -> 'delta') <> 'null'::jsonb))) = 0 and (select count(*) from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'order' and c.version > 1) >= 6, (select count(*) from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.kind = 'order' and c.version > 1)::text); -- ── 18 · change 6: the 'event' kind — only its known types; till_start once, at seq 1 ── begin perform public.till_write('demo-mk65q66spjck0g9mxt50btfxtr', 'event', 'bogus', null, 'proof', current_date, '{}'::jsonb, null, null); st := 'allowed'; exception when others then st := sqlstate; end; perform pg_temp.rbp_ok('18b · an event of an unknown type is refused by the chain''s check (23514); till_start is written once per truck, at seq 1', st = '23514' and (select count(*) from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and kind = 'event' and ref = 'till_start') = 1 and (select seq from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and kind = 'event' and ref = 'till_start') = 1, st); -- ── 12 · no personal data, note or free text in any payload; canonical text independent of key order ── perform pg_temp.rbp_ok('12a · no payload holds a customer name, email, phone, order note, dish note, line note, staff note or staff id — values or keys', not exists (select 1 from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and (c.payload ~* '(Rollback Proof Customer|rbp-customer@|\+3360000000|No onions|coeliac|gluten|pending note|staff note|rbp-staff-user|rbp:)' or c.payload ~ '"(customer_name|customer_email|customer_phone|notes|line_notes|table_ref|cancellation_reason|rejection_reason|note|created_by|idempotency_key|specialInstructions|slotNotes)"')), (select string_agg(left(c.payload, 120), ' | ') from public.till_chain c where c.truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and c.payload ~* '(Rollback Proof Customer|No onions|gluten|staff note)')); s1 := public.till_sealed_lines('[{"quantity":1,"name":"x","unit_price":2.50,"colour":"red","specialInstructions":"no"}]', 'item')::text; s2 := public.till_sealed_lines('[{"specialInstructions":"no","colour":"red","unit_price":2.50,"name":"x","quantity":1}]', 'item')::text; perform pg_temp.rbp_ok('12b · the canonical text does not depend on the order keys were written in; an unknown key is named (not its value); the note key leaves no trace; 2.50 stays 2.50', s1 = s2 and s1 = '[{"name": "x", "quantity": 1, "unit_price": 2.50, "_other_keys": ["colour"]}]', s1 || ' / ' || s2); perform pg_temp.rbp_clean('12', array['demo-mk65q66spjck0g9mxt50btfxtr', 'test-truck-2']); -- ── 19 · change 1: no till trigger wrote an order or payment row, at any step ── perform pg_temp.rbp_ok('19b · after every step, every order and payment row of both trucks carries this transaction''s own xid — none was written inside a till trigger''s subtransaction', (select count(*) from _till_clean) >= 12 and not exists (select 1 from _till_clean where bad is not null), (select string_agg(label || ': ' || coalesce(bad, '-'), ' | ') from _till_clean)); -- ── 13 · the chain at the end: verified in every respect ── v := public.till_verify('demo-mk65q66spjck0g9mxt50btfxtr'); perform pg_temp.rbp_ok('13 · till_verify(truck A) at the end: ok — gap-free, every link and hash right, the head matches, seq 1 till_start, every identity reference, version, delta, till_id and VAT reconciliation right (one recomputed basis, the proof''s own)', (v ->> 'ok')::boolean and (v ->> 'gaps')::int = 0 and (v ->> 'bad_links')::int = 0 and (v ->> 'bad_hashes')::int = 0 and (v ->> 'bad_payload_hashes')::int = 0 and (v ->> 'head_ok')::boolean and (v ->> 'structure')::int = 0 and (v ->> 'bad_identity_refs')::int = 0 and (v ->> 'bad_versions')::int = 0 and (v ->> 'bad_deltas')::int = 0 and (v ->> 'no_till_id')::int = 0 and (v ->> 'unreconciled')::int = 0 and (v ->> 'vat_recomputed')::int = 1, v::text); end $proof$
SQL [till]> select label, ok, detail from _till_proof order by n
  ✓ 1 · the deployed place_order_atomic_v2 call, the walk-up insert, the offline replay upsert (inserted, then skipped) and the card promotion insert all succeed; the three ACCEPTED inserts are sealed at once (v1 accepted), the PENDING promotion is not
  ✓ 18a · the truck's chain begins with the till_start event (seq 1), then its identity entry (seq 2), before its first order
  ✓ 2a · mark paid on an accepted (already sealed) order: one payment entry, no new order version
  ✓ 2b · the payment cache write-back (payment_status, amount_paid) makes no version
  ✓ 2c · collect: exactly one payment entry plus one order version (v2 state_change, collected)
  ✓ 2d · a pending order stays UNSEALED through changes; accepting it seals v1 (accepted); the online charge then chains one payment entry and no version
  ✓ 2e · online refund: one payment entry, no new order version
  ✓ 2f · the platform fee fill on a chained payment (not sealed) makes no entry and no guard event
  ✓ 2g · a payment on a still-PENDING order (no code path does this today) seals it at that first payment (Q1), as pending
  ✓ 4 · the deployed undo (DELETE of the charge) still deletes; it is logged as a would-be refusal and chained as a deletion; the status back makes v3
  ✓ 5a · an edit before the day's close makes version 2 (edit), with no guard event
  ✓ 17a · its delta (change 5): minus the old line, plus the new one (each with its VAT figures); total_minor +500; per rate excl. VAT +454 and VAT +46; the six changed field names
  ✓ 5b · three days ago: the late payment is dated today (its order's day is closed); an edit makes v2 edit_after_close AND logs would_refuse_after_close (allowed); the placed_at fill makes v3 with no guard event
  ✓ 6 · the retention patch (old-style: name, email, phone, note, dish note blanked inside items; new-style: line_notes blanked), the line-notes move and account deletion's anonymisation + notes patch make NO version — and till_verify stays true
  ✓ 7 · kitchen status moves (cooking, ready, back), a slot change and a buzzer make no version
  ✓ 8 · demo trucks are skipped by default: an insert, a payment, a collect and an order delete (its payment cascading) on demo trucks chain nothing, log nothing, and succeed
  ✓ 8b · with the till on, deleting a sealed order (its payment cascading) is ALLOWED in observe mode, logged for both rows, chained as two deletions, its seal state marked deleted — and till_verify stays true
  ✓ 9 · UPDATE / DELETE on till_chain and action_audit_log are refused (HGT01); an INSERT into action_audit_log works
  ✓ 10 · till_baseline(truck) seals every unsealed non-pending order and chains every unchained payment once (reason baseline); a pending order stays unsealed; a second run does nothing; till_verify is true with nothing left unsealed
  ✓ 19a · the baseline wrote NO order or payment row: every row of both trucks has the same ctid, xmin and updated_at before and after it (so no realtime event either)
  ✓ 14a · a mixed-rate French order (5.5 %, 10 %, 20 %; a deal split 10 % / 20 % by the VAT engine; a 10 % discount): basis breakdown; Galette 1227, Cidre 300, Pain 282, the deal's parts 696 + 337 excl. VAT; per rate 282 / 1923 / 637 + VAT 15 / 192 / 128 = the food 3177
  ✓ 14b · VAT added (US, 6.625 %, a tip and a service fee): excl = food 1600, VAT 106 = tax_minor, total 2006; a pre-charge-columns order (legacy, no rate) with an old deal (no split): Fish 900 + Combo 700 = (subtotal − discount); one older rate on the order (20 % included): 1000 + 200; JPY (no decimals): 1364 + 136; a breakdown that does not match the lines: recomputed, 455 + 45 — every one reconciling
  ✓ 14c · the check is real: one line's excl. VAT +1, or the order's total +1, no longer reconciles
  ✓ 15 · till_id: the van's id for an order with a van; 'web' for an online order without one; 'manual' for a walk-up; 'unrecorded' when even the source is empty — and no order version anywhere without one
  ✓ 16 · the identity: one entry before the first order; a change of the receipt details writes identity v2 at once (whitelisted: legal name, address — its unknown key named only — SIRET, VAT number, regime); a non-change writes nothing; the next order version names identity v2 {seq, hash}; no order or payment row touched
  ✓ 17b · every order version 2+ carries a plus/minus delta, every version 1 none
  ✓ 18b · an event of an unknown type is refused by the chain's check (23514); till_start is written once per truck, at seq 1
  ✓ 12a · no payload holds a customer name, email, phone, order note, dish note, line note, staff note or staff id — values or keys
  ✓ 12b · the canonical text does not depend on the order keys were written in; an unknown key is named (not its value); the note key leaves no trace; 2.50 stays 2.50
  ✓ 19b · after every step, every order and payment row of both trucks carries this transaction's own xid — none was written inside a till trigger's subtransaction
