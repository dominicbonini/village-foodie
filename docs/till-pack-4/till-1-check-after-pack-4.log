*)::int from ins $f$; create function pg_temp.rbp_promote(p_truck text) returns uuid language sql as $f$ insert into public.orders (order_key, id, truck_id, customer_name, customer_email, customer_phone, order_type, table_ref, slot, requested_slot, asap_estimate, event_date, event_id, van_id, items, deals, extras, bundle, discount_code, subtotal, discount_amt, total, total_minor, notes, status, payment_status, placed_at) values (gen_random_uuid(), 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', null, null, 'collection', null, null, null, null, current_date, null, null, '[{"name":"Crêpe","quantity":1,"unit_price":5}]'::jsonb, null, null, null, null, 5, 0, 5, 500, null, 'pending', 'unpaid', now()) returning order_key $f$; create function pg_temp.rbp_pay(p_key uuid, p_kind text, p_channel text, p_method text, p_amount integer, p_ref text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode) select o.order_key, o.truck_id, p_kind, p_channel, p_amount, o.currency, 'succeeded', p_ref, 'rollback proof — staff note', 'rbp:' || gen_random_uuid(), 'rbp-staff-user', p_method, false from public.orders o where o.order_key = p_key returning id $f$; create function pg_temp.rbp_entries(p_truck text, p_kind text, p_ref text) returns integer language sql as $f$ select count(*)::int from public.till_chain c where c.truck_id = p_truck and c.kind = p_kind and c.ref = p_ref $f$; create function pg_temp.rbp_reasons(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(c.version || ':' || (c.payload::jsonb ->> 'reason') || ':' || coalesce(c.payload::jsonb -> 'data' ->> 'fiscal_state', ''), ',' order by c.seq), '') from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref $f$; create function pg_temp.rbp_events(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(g.event, ',' order by g.id), '') from public.till_guard_events g where g.truck_id = p_truck and g.ref = p_ref $f$; create function pg_temp.rbp_data(p_truck text, p_ref text) returns jsonb language sql as $f$ select c.payload::jsonb from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref order by c.seq desc limit 1 $f$; create function pg_temp.rbp_snap(p_trucks text[]) returns text language sql as $f$ select coalesce(string_agg(x, ';' order by x), '') from ( select 'o:' || o.order_key || '@' || o.ctid::text || '/' || o.xmin::text || '/' || coalesce(o.updated_at::text, '') as x from public.orders o where o.truck_id = any (p_trucks) union all select 'p:' || p.id || '@' || p.ctid::text || '/' || p.xmin::text from public.order_payments p where p.truck_id = any (p_trucks)) z $f$; create function pg_temp.rbp_clean(p_label text, p_trucks text[]) returns void language sql as $f$ insert into _till_clean (label, bad) select p_label, string_agg(z.k, ',') from ( select 'order ' || o.order_key as k from public.orders o where o.truck_id = any (p_trucks) and o.xmin::text <> (pg_current_xact_id()::xid)::text union all select 'payment ' || p.id from public.order_payments p where p.truck_id = any (p_trucks) and p.xmin::text <> (pg_current_xact_id()::xid)::text) z $f$;
