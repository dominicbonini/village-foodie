SQL [till]> create temp table _till_proof (n serial primary key, label text not null, ok boolean, detail text); create temp table _till_clean (n serial primary key, label text not null, bad text); create function pg_temp.rbp_ok(p_label text, p_ok boolean, p_detail text) returns void language sql as $f$ insert into _till_proof (label, ok, detail) values (p_label, coalesce(p_ok, false), left(p_detail, 900)) $f$; create function pg_temp.rbp_food(p_items jsonb) returns integer language sql as $f$ select coalesce(sum(round((e ->> 'unit_price')::numeric * (e ->> 'quantity')::numeric * 100)), 0)::integer from jsonb_array_elements(p_items) e $f$; create function pg_temp.rbp_bd(p_food integer) returns jsonb language sql as $f$ select jsonb_build_array(jsonb_build_object('rate_milli', 10000, 'food_minor', p_food, 'gross_minor', p_food, 'net_minor', p_food - round(p_food * 10000 / 110000.0)::integer, 'tax_minor', round(p_food * 10000 / 110000.0)::integer)) $f$; create function pg_temp.rbp_walkup(p_truck text, p_day date, p_items jsonb, p_status text, p_name text, p_email text, p_phone text, p_notes text, p_line_notes jsonb) returns uuid language sql as $f$ insert into public.orders (id, truck_id, customer_name, customer_phone, customer_email, slot, order_type, event_date, event_id, items, deals, discount_code, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, card_fee_payer, status, payment_status, source, notes, line_notes) select 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, p_name, p_phone, p_email, null, 'collection', p_day, null, p_items, null, null, round(z.f / 100.0, 2), 0, round(z.f / 100.0, 2), z.f, z.f, 0, 10000, true, 'TVA', pg_temp.rbp_bd(z.f), 'truck', p_status, 'unpaid', 'manual', p_notes, p_line_notes from (select pg_temp.rbp_food(p_items) as f) z returning order_key $f$; create function pg_temp.rbp_set_items(p_key uuid, p_items jsonb) returns void language sql as $f$ update public.orders o set items = p_items, subtotal = round(z.f / 100.0, 2), total = round(z.f / 100.0, 2), total_minor = z.f, food_minor = z.f, tax_breakdown = case when o.tax_breakdown is null then null else pg_temp.rbp_bd(z.f) end from (select pg_temp.rbp_food(p_items) as f) z where o.order_key = p_key $f$; create function pg_temp.rbp_full(p_truck text, p_status text, p_source text, p_van uuid, p_currency text, p_items jsonb, p_deals jsonb, p_subtotal numeric, p_discount numeric, p_total numeric, p_total_minor integer, p_food integer, p_tax integer, p_rate integer, p_incl boolean, p_bd jsonb, p_tip integer, p_fee integer) returns uuid language sql as $f$ insert into public.orders (id, truck_id, customer_name, order_type, event_date, items, deals, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_rate_milli, tax_inclusive, tax_label, tax_breakdown, tip_minor, service_fee_minor, service_fee_recipient, card_fee_payer, status, payment_status, source, van_id, currency) values ('rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, p_items, p_deals, p_subtotal, p_discount, p_total, p_total_minor, p_food, p_tax, p_rate, p_incl, case when p_incl then 'TVA' else 'Sales tax' end, p_bd, p_tip, p_fee, case when p_fee > 0 then 'truck' end, 'truck', p_status, 'unpaid', p_source, p_van, p_currency) returning order_key $f$; create function pg_temp.rbp_replay(p_truck text, p_key uuid) returns integer language sql as $f$ with ins as (insert into public.orders (order_key, id, truck_id, customer_name, order_type, event_date, items, subtotal, discount_amt, total, total_minor, food_minor, tax_minor, tax_inclusive, tax_label, card_fee_payer, status, payment_status, source) values (p_key, 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', 'collection', current_date, '[]'::jsonb, 0, 0, 0, 0, 0, 0, true, 'TVA', 'truck', 'confirmed', 'unpaid', 'manual') on conflict (order_key) do nothing returning 1) select count(*)::int from ins $f$; create function pg_temp.rbp_promote(p_truck text) returns uuid language sql as $f$ insert into public.orders (order_key, id, truck_id, customer_name, customer_email, customer_phone, order_type, table_ref, slot, requested_slot, asap_estimate, event_date, event_id, van_id, items, deals, extras, bundle, discount_code, subtotal, discount_amt, total, total_minor, notes, status, payment_status, placed_at) values (gen_random_uuid(), 'rbp-' || substr(md5(random()::text), 1, 8), p_truck, 'rollback proof', null, null, 'collection', null, null, null, null, current_date, null, null, '[{"name":"Crêpe","quantity":1,"unit_price":5}]'::jsonb, null, null, null, null, 5, 0, 5, 500, null, 'pending', 'unpaid', now()) returning order_key $f$; create function pg_temp.rbp_pay(p_key uuid, p_kind text, p_channel text, p_method text, p_amount integer, p_ref text) returns uuid language sql as $f$ insert into public.order_payments (order_key, truck_id, kind, channel, amount_minor, currency, state, external_ref, note, idempotency_key, created_by, method, livemode) select o.order_key, o.truck_id, p_kind, p_channel, p_amount, o.currency, 'succeeded', p_ref, 'rollback proof — staff note', 'rbp:' || gen_random_uuid(), 'rbp-staff-user', p_method, false from public.orders o where o.order_key = p_key returning id $f$; create function pg_temp.rbp_entries(p_truck text, p_kind text, p_ref text) returns integer language sql as $f$ select count(*)::int from public.till_chain c where c.truck_id = p_truck and c.kind = p_kind and c.ref = p_ref $f$; create function pg_temp.rbp_reasons(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(c.version || ':' || (c.payload::jsonb ->> 'reason') || ':' || coalesce(c.payload::jsonb -> 'data' ->> 'fiscal_state', ''), ',' order by c.seq), '') from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref $f$; create function pg_temp.rbp_events(p_truck text, p_ref text) returns text language sql as $f$ select coalesce(string_agg(g.event, ',' order by g.id), '') from public.till_guard_events g where g.truck_id = p_truck and g.ref = p_ref $f$; create function pg_temp.rbp_data(p_truck text, p_ref text) returns jsonb language sql as $f$ select c.payload::jsonb from public.till_chain c where c.truck_id = p_truck and c.kind = 'order' and c.ref = p_ref order by c.seq desc limit 1 $f$; create function pg_temp.rbp_snap(p_trucks text[]) returns text language sql as $f$ select coalesce(string_agg(x, ';' order by x), '') from ( select 'o:' || o.order_key || '@' || o.ctid::text || '/' || o.xmin::text || '/' || coalesce(o.updated_at::text, '') as x from public.orders o where o.truck_id = any (p_trucks) union all select 'p:' || p.id || '@' || p.ctid::text || '/' || p.xmin::text from public.order_payments p where p.truck_id = any (p_trucks)) z $f$; create function pg_temp.rbp_clean(p_label text, p_trucks text[]) returns void language sql as $f$ insert into _till_clean (label, bad) select p_label, string_agg(z.k, ',') from ( select 'order ' || o.order_key as k from public.orders o where o.truck_id = any (p_trucks) and o.xmin::text <> (pg_current_xact_id()::xid)::text union all select 'payment ' || p.id from public.order_payments p where p.truck_id = any (p_trucks) and p.xmin::text <> (pg_current_xact_id()::xid)::text) z $f$; create function pg_temp.rbp_vatsig(x jsonb) returns jsonb language sql as $f$ select jsonb_build_object('b', x -> 'vat_basis', 'i', coalesce((select jsonb_agg(jsonb_build_array(t.e -> 'vat_rate_milli', t.e -> 'line_price_minor', t.e -> 'line_total_excl_vat_minor') order by t.n) from jsonb_array_elements(case when jsonb_typeof(x -> 'items') = 'array' then x -> 'items' else '[]'::jsonb end) with ordinality t(e, n)), '[]'::jsonb), 'd', coalesce((select jsonb_agg((select coalesce(jsonb_agg(jsonb_build_array(u.e -> 'vat_rate_milli', u.e -> 'line_price_minor', u.e -> 'line_total_excl_vat_minor') order by u.n), '[]'::jsonb) from jsonb_array_elements(t.e -> 'vat_parts') with ordinality u(e, n)) order by t.n) from jsonb_array_elements(case when jsonb_typeof(x -> 'deals') = 'array' then x -> 'deals' else '[]'::jsonb end) with ordinality t(e, n)), '[]'::jsonb), 's', coalesce((select jsonb_agg(jsonb_build_array(t.e -> 'vat_rate_milli', t.e -> 'food_minor', t.e -> 'excl_vat_minor', t.e -> 'vat_minor') order by t.n) from jsonb_array_elements(x -> 'vat_summary') with ordinality t(e, n)), '[]'::jsonb)) $f$;
SQL [till]> do $proof$ declare k_fn uuid; k_walk uuid; k_rep uuid; k_pro uuid; k_pp uuid; k_late uuid; k_old uuid; k_old2 uuid; k_new uuid; k_b uuid; k_off uuid; k_bl1 uuid; k_bl2 uuid; k_bl3 uuid; k_ff uuid; k_mix uuid; k_us uuid; k_leg uuid; k_or uuid; k_jp uuid; k_rc uuid; k_van uuid; k_web uuid; k_src uuid; p1 uuid; p2 uuid; p3 uuid; p4 uuid; p5 uuid; pf uuid; pb uuid; pbl uuid; p_old uuid; p_new uuid; p_old2 uuid; p_pp uuid; v_van uuid; c1 integer; c2 integer; c3 integer; n_ord integer; n_pay integer; e0 integer; n_id integer; aud uuid; st text; st2 text; st3 text; st4 text; st5 text; st6 text; s1 text; s2 text; ff text; v jsonb; v2 jsonb; vb jsonb; vb2 jsonb; d jsonb; x jsonb; y jsonb; begin perform set_config('till.include_demo', 'on', true); -- ── 1 · the deployed insert paths: all succeed; an ACCEPTED insert is sealed at once (change 1), a PENDING one is not ── k_fn := ((public.place_order_atomic_v2('{"customer_name":"rollback proof","customer_email":null,"customer_phone":null,"order_type":"collection","items":[{"name":"Crêpe","quantity":1,"unit_price":5}],"deals":null,"discount_code":null,"subtotal":5,"discount_amt":0,"total":5,"notes":null,"van_id":null,"payment_status":"unpaid","total_minor":500,"food_minor":500,"tax_minor":0,"tax_rate_milli":10000,"tax_inclusive":true,"tax_label":"TVA","tip_minor":0,"tip_pct_bps":null,"service_fee_minor":0,"service_fee_recipient":null,"card_surcharge_minor":0,"card_funding":null,"card_fee_payer":"truck","application_fee_minor":null}'::jsonb, null, 'confirmed', null, 'demo-mk65q66spjck0g9mxt50btfxtr', current_date, null)) ->> 'order_key')::uuid; k_walk := pg_temp.rbp_walkup('demo-mk65q66spjck0g9mxt50btfxtr', current_date, '[{"name":"Crêpe","quantity":1,"unit_price":5}]', 'confirmed', 'rollback proof', null, null, null, null); k_rep := gen_random_uuid(); c1 := pg_temp.rbp_replay('demo-mk65q66spjck0g9mxt50btfxtr', k_rep); c2 := pg_temp.rbp_replay('demo-mk65q66spjck0g9mxt50btfxtr', k_rep); k_pro := pg_temp.rbp_promote('demo-mk65q66spjck0g9mxt50btfxtr'); perform pg_temp.rbp_ok('1 · the deployed place_order_atomic_v2 call, the walk-up insert, the offline replay upsert (inserted, then skipped) and the card promotion insert all succeed; the three ACCEPTED inserts are sealed at once (v1 accepted), the PENDING promotion is not', (select count(*) from public.orders where order_key in (k_fn, k_walk, k_rep, k_pro)) = 4 and c1 = 1 and c2 = 0 and pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_fn::text) = '1:accepted:accepted' and pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_walk::text) = '1:accepted:accepted' and pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_rep::text) = '1:accepted:accepted' and pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_pro::text) = '' and (select count(*) from public.till_order_seals where order_key in (k_fn, k_walk, k_rep)) = 3 and not exists (select 1 from public.till_order_seals where order_key = k_pro), json_build_object('replay', array[c1, c2], 'fn', pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_fn::text), 'walk', pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_walk::text), 'rep', pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_rep::text), 'pro', pg_temp.rbp_reasons('demo-mk65q66spjck0g9mxt50btfxtr', k_pro::text))::text); perform pg_temp.rbp_ok('18a · the truck''s chain begins with the till_start event (seq 1), then its identity entry (seq 2), before its first order', (select kind || ':' || ref from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and seq = 1) = 'event:till_start' and (select kind || ':' || version from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and seq = 2) = 'identity:1' and (select min(seq) from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' and kind = 'order') = 3, (select string_agg(seq || ':' || kind || ':' || ref, ', ' order by seq) from public.till_chain where truck_id = 'demo-mk65q66spjck0g9mxt50btfxtr' 