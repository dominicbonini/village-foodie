SQL [till]> select (select bool_and(relrowsecurity) from pg_class where relnamespace = 'public'::regnamespace and relname in ('till_settings','till_chain','till_chain_heads','till_order_seals','till_failures','till_guard_events')) as rls_on, (select count(*) from pg_class where relnamespace = 'public'::regnamespace and relname in ('till_settings','till_chain','till_chain_heads','till_order_seals','till_failures','till_guard_events'))::int as tables, has_table_privilege('anon', 'public.till_chain', 'SELECT') or has_table_privilege('authenticated', 'public.till_chain', 'SELECT') or has_table_privilege('anon', 'public.till_order_seals', 'SELECT') or has_table_privilege('authenticated', 'public.till_order_seals', 'SELECT') as api_reads, (select bool_or(has_table_privilege('service_role', t, p)) from unnest(array['public.till_chain', 'public.till_chain_heads', 'public.till_order_seals']) t, unnest(array['INSERT', 'UPDATE', 'DELETE']) p) as service_writes, has_table_privilege('service_role', 'public.action_audit_log', 'UPDATE') or has_table_privilege('service_role', 'public.action_audit_log', 'DELETE') as service_changes_audit, has_table_privilege('service_role', 'public.action_audit_log', 'INSERT') as service_inserts_audit, has_function_privilege('anon', 'public.till_append(text,text,text,integer,text,date,jsonb,jsonb)', 'EXECUTE') or has_function_privilege('service_role', 'public.till_append(text,text,text,integer,text,date,jsonb,jsonb)', 'EXECUTE') or has_function_privilege('service_role', 'public.till_write(text,text,text,integer,text,date,jsonb,jsonb,jsonb)', 'EXECUTE') or has_function_privilege('service_role', 'public.till_seal(uuid,text)', 'EXECUTE') as api_appends, has_function_privilege('service_role', 'public.till_baseline(text)', 'EXECUTE') as service_baseline, has_function_privilege('service_role', 'public.till_verify(text)', 'EXECUTE') and not has_function_privilege('anon', 'public.till_verify(text)', 'EXECUTE') as verify_service_only, (select guard_mode from public.till_settings) as guard_mode, (select software_version from public.till_settings) as software_version, md5(pg_get_functiondef('public.place_order_atomic_v2(jsonb,text,text,uuid,text,date,jsonb)'::regprocedure)) as v2_md5, (select count(*) from information_schema.columns where table_schema = 'public' and table_name in ('orders', 'order_payments') and column_name like 'seal%')::int as seal_columns, (select string_agg(c.relname || '.' || t.tgname || ':' || case when (t.tgtype & 2) = 2 then 'before' else 'after' end, ',' order by c.relname, t.tgname) from pg_trigger t join pg_class c on c.oid = t.tgrelid where not t.tgisinternal and t.tgname like '%till%' and c.relname in ('orders', 'order_payments', 'trucks')) as till_triggers
